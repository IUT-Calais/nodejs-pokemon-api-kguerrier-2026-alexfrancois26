generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Type {
  id   Int    @id @default(autoincrement())
  name String @unique
  pokemonTypes PokemonCard[] @relation(name: "pokemonType")
  pokemonWeaknesses PokemonCard[] @relation(name: "pokemonWeakness")
}

model PokemonCard {
  id Int @id @default(autoincrement()) // Identifiant unique de la carte 
  name String @unique // Nom du pokémon
  pokedexId Int @unique // Identifiant du pokémon dans le Pokédex
  type Type @relation(name: "pokemonType", fields: [typeId], references: [id]) // Type du pokémon (relation 1-N)
  typeId Int // Clé étrangère vers le type
  weaknessType Type? @relation(name: "pokemonWeakness", fields: [weaknessTypeId], references: [id]) // Type contre lequel le pokémon est faible
  weaknessTypeId Int? // Clé étrangère optionnelle vers le type de faiblesse
  lifePoints Int // Points de vie 
  size Float? // taille
  weight Float? // poids
  imageUrl String? // Url de l'image du pokémon 
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String 
}